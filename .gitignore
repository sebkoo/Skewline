# Xcode
.DS_Store
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Python (the fit harness's virtual environment; the interpreter pin in
# .python-version and the exact numpy pin in Fit/requirements.txt are
# what is committed)
.venv/
__pycache__/

# macOS
.AppleDouble
.LSOverride

# Claude Code session state
.claude/*
!.claude/settings.json

# Never commit
PRIVATE-*.md

# Observation exports. These derive from home captures and stay beside them;
# a /2 file carries a frame index and a pixel per row, which grouped by frame
# is a subsampled depth image of a room. This is advisory only -- `git add -f`
# beats it -- and the guard that actually holds is in Scripts/readme-drift.swift,
# which fails on any file whose first line is an observation schema tag.
*observations*.csv
*geometry*.csv

# Transient artifact staging (outside reviewer)
.tmp-*/
